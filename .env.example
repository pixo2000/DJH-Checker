# Jugendherberge: Name (wie auf jugendherberge.de) ODER direkt die ID
DJH_NAME=Köln-Deutz
#DJH_ID=450

# Reisezeitraum (TT.MM.JJJJ oder JJJJ-MM-TT)
ARRIVAL=23.08.2027
DEPARTURE=30.08.2027

# Personen nach Alter
PERSONS_16=0
PERSONS_17=0
PERSONS_18_26=2
PERSONS_27_PLUS=0

# Prüfintervall in Sekunden (min. 60)
CHECK_INTERVAL=1800

# ntfy-Benachrichtigung
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=mein-geheimes-djh-topic
#NTFY_TOKEN=
NTFY_PRIORITY=high
# Auch benachrichtigen, wenn es wieder ausgebucht ist
NOTIFY_UNAVAILABLE=false
# Beim Start eine Info-Nachricht senden
NOTIFY_STARTUP=false

# Fehler-Benachrichtigungen:
# Netzwerkfehler (Timeout, Verbindung, HTTP 5xx) erst nach so vielen Fehlern in Folge melden
ERROR_NOTIFY_AFTER=2
# Blockade (403/429/Captcha) oder unerwartete Antwort nach so vielen Fehlern in Folge melden
ANOMALY_NOTIFY_AFTER=1

LOG_LEVEL=INFO
